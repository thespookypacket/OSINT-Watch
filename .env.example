# Generate unique credentials using python3 scripts/setup.py. Never commit .env.
POSTGRES_PASSWORD=
WATCH_GIS_PASSWORD=
WATCH_ADMIN_USERNAME=admin
WATCH_ADMIN_PASSWORD=
WATCH_PUBLIC_URL=http://localhost:8080
WATCH_BIND=127.0.0.1
WATCH_PORT=8080
WATCH_SECURE_COOKIES=false
WATCH_FIRMS_KEY=
WATCH_USER_AGENT=OSINT-Watch/0.1 (configure your contact address here)
WATCH_OLLAMA_URL=
WATCH_OLLAMA_MODEL=qwen2.5:3b
WATCH_SPIDERFOOT_URL=
WATCH_SPIDERFOOT_TOKEN=
WATCH_ALLOWED_OUTBOUND_HOSTS=
WATCH_BASEMAP_URL=https://tiles.openfreemap.org/styles/liberty
WATCH_RAW_RETENTION_DAYS=7
WATCH_RETENTION_DAYS=90

# One-way NetBox site sync. Base URL may include a deployment subpath.
WATCH_NETBOX_URL=
WATCH_NETBOX_TOKEN=
# Seconds; 0 disables scheduled sync, leaving Sync now available.
WATCH_NETBOX_INTERVAL_SECONDS=3600
